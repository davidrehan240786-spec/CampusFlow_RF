{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "role": { "type": "string", "enum": ["student", "staff", "admin"], "description": "User's role in the system" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "displayName", "email", "role"]
    },
    "MarketplaceItem": {
      "title": "Marketplace Item",
      "description": "An item listed for sale in the campus marketplace",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Item title" },
        "description": { "type": "string", "description": "Item description" },
        "price": { "type": "string", "description": "Item price" },
        "category": { "type": "string", "description": "Item category" },
        "location": { "type": "string", "description": "Pickup location" },
        "condition": { "type": "string", "description": "Item condition" },
        "image": { "type": "string", "description": "Main item image URL" },
        "sellerId": { "type": "string", "description": "UID of the seller" },
        "sellerName": { "type": "string", "description": "Name of the seller" },
        "status": { "type": "string", "enum": ["active", "sold", "deleted"], "description": "Listing status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Listing creation timestamp" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Item tags" },
        "allowPhone": { "type": "boolean", "description": "Whether phone contact is enabled" },
        "phoneNumber": { "type": "string", "description": "Seller's phone number" }
      },
      "required": ["name", "category", "location", "sellerId", "status"]
    },
    "LostFoundReport": {
      "title": "Lost & Found Report",
      "description": "A report for a lost or found item",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["lost", "found"], "description": "Report type" },
        "name": { "type": "string", "description": "Item name" },
        "description": { "type": "string", "description": "Item description" },
        "location": { "type": "string", "description": "Location where lost or found" },
        "dateLost": { "type": "string", "description": "Date when item was lost" },
        "dateFound": { "type": "string", "description": "Date when item was found" },
        "image": { "type": "string", "description": "Item image URL" },
        "reporterId": { "type": "string", "description": "UID of the reporter" },
        "reporterName": { "type": "string", "description": "Name of the reporter" },
        "status": { "type": "string", "enum": ["active", "resolved", "deleted"], "description": "Report status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Report creation timestamp" },
        "category": { "type": "string", "description": "Item category" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Report tags" },
        "reward": { "type": "string", "description": "Reward for lost item" },
        "collectionPoint": { "type": "string", "description": "Collection point for found item" },
        "contactMethod": { "type": "string", "description": "Preferred contact method" },
        "phoneNumber": { "type": "string", "description": "Reporter's phone number" }
      },
      "required": ["type", "name", "location", "reporterId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/marketplace/{itemId}": {
      "schema": "MarketplaceItem",
      "description": "Marketplace listings"
    },
    "/lostfound/{reportId}": {
      "schema": "LostFoundReport",
      "description": "Lost and found reports"
    }
  }
}
